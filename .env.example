# Set at least one. Tried in this order: Agnes, Groq, Gemini, OpenRouter.
AGNES_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Model IDs on free tiers change often. Override here rather than editing llm.py.
# AGNES_MODEL=agnes-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Skip loading the embedding model for fast server restarts.
# PLB_NO_DENSE=1
